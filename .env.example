# MWRD V3 — environment template. Copy to .env.local and fill in values.
# .env.local is gitignored. Never commit real credentials.

# Supabase project (Bahrain region)
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<publishable_or_anon_key>
SUPABASE_SERVICE_ROLE_KEY=<secret_or_service_role_key>

# Postgres direct connection — used by drizzle-kit migrate/push/studio only.
# Source: Supabase Dashboard → Settings → Database → Connection info → Direct connection.
DATABASE_URL=postgresql://postgres:<DB_PASSWORD>@db.<project-ref>.supabase.co:5432/postgres

# Resend (transactional email) — needed Week 3 onward
RESEND_API_KEY=

# Moyasar payments — needed Week 7. Test keys only until Week 10 live smoke.
MOYASAR_SECRET_KEY=
MOYASAR_PUBLISHABLE_KEY=
MOYASAR_WEBHOOK_SECRET=
